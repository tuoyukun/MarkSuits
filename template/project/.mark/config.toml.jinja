# Mark project configuration. The engine (plugin) reads this file; it never
# hardcodes project paths. Keep it in git.
mark_schema = 1
locale = "{{ locale }}"
profile = "{{ profile }}"

# Pipeline roles (file names of the agents in .claude/agents/, without ".md").
roles = ["designer", "coder-plan", "coder-impl", "tester", "fix-plan"]

[project]
name = "{{ project_name }}"
main_branch = "{{ main_branch }}"

[paths]
state_dir = ".mark"
frontend = "{{ frontend_dir }}"
backend = "{{ backend_dir }}"
ui = "{{ ui_dir }}"
tests = "{{ tests_dir }}"

# Gate each role needs before dispatch, as `.mark/gates/<id>.<gate>` (feature tickets only;
# the bug chain has no review gates). A human may waive a gate that has nothing to
# review by creating `<id>.<gate>.waived` instead.
[gates]
coder-plan = "design-approved"
coder-impl = "plan-approved"
tester = "plan-approved"

# Files a role must leave in the ticket directory before it may stop.
# A prompt can override this per dispatch with `<!-- mark:outputs a.md,b.md -->`.
[outputs]
designer = ["design.md"]
coder-plan = ["tech-plan.md"]
fix-plan = ["fix-plan.md"]
coder-impl = ["handoff.md"]
tester = ["verdict.md"]

# A feature that has design.md and whose branch changes these paths goes through
# design QA (designer checks the integrated UI) before testing.
[design_qa]
paths = ["{{ frontend_dir }}/**"]
exclude = ["**/__tests__/**", "**/*.test.*", "**/*.spec.*"]

# `mark merge` runs this shell command in the ticket's worktree after merging the latest
# main into the branch; exit 0 = green. Empty: merge on the tester's verdict alone.
[merge]
regression = "{{ regression_cmd }}"

[worktree]
dir = ".claude/worktrees"
# The main checkout is a state lane: only ticket dirs, gates and locks change there.
# List extra globs here if your team edits them directly on main.
main_writable = []

# Doc budgets: byte limits for the docs every role loads, so their context does not
# grow by one harmless line at a time. First matching glob wins; max_bytes = 0 exempts
# a path from a broader rule. A write may not leave a doc over budget and larger than it
# was (shrinking an oversized doc is fine), and `mark merge` refuses a branch that does.
# Budget docs whose length follows process complexity, not delivered work: a byte wall on
# an index or a log can only be passed by deleting someone else's record. Delete all
# entries to turn budgets off.
[[doc_budget]]
glob = "**/CLAUDE.md"
max_bytes = 16384

[[doc_budget]]
glob = ".mark/collaboration.md"
max_bytes = 12288

[[doc_budget]]
glob = ".claude/agents/*.md"
max_bytes = 12288

[[doc_budget]]
glob = ".mark/prompts/*.md"
max_bytes = 6144

[[doc_budget]]
glob = ".mark/formats/*.md"
max_bytes = 6144

# A fix plan points coder-impl at the fix; it does not write the code for it.
[[doc_budget]]
glob = ".mark/bugs/*/fix-plan.md"
max_bytes = 12288

# Write scopes. First matching glob wins; paths that match nothing are open to all.
# "main" is the orchestrator (main thread). The engine adds fixed rules before these
# that no project can loosen: .claude/**, .mark/config.toml, gates, locks, status.md
# and review-*.md are main-thread only.
[[write_rules]]
glob = "**/requirement.md"
roles = ["main"]

[[write_rules]]
glob = "**/bug.md"
roles = ["main"]

[[write_rules]]
glob = "**/design.md"
roles = ["designer"]

[[write_rules]]
glob = "**/design-qa.md"
roles = ["designer"]

[[write_rules]]
glob = "{{ ui_dir }}/**"
roles = ["designer"]

[[write_rules]]
glob = "**/tech-plan.md"
roles = ["coder-plan"]

[[write_rules]]
glob = "**/fix-plan.md"
roles = ["fix-plan"]

[[write_rules]]
glob = "**/handoff.md"
roles = ["coder-impl"]

[[write_rules]]
glob = "**/verdict.md"
roles = ["tester"]

[[write_rules]]
glob = "{{ tests_dir }}/**"
roles = ["tester"]

[[write_rules]]
glob = "{{ frontend_dir }}/**"
roles = ["coder-impl"]

[[write_rules]]
glob = "{{ backend_dir }}/**"
roles = ["coder-impl"]
