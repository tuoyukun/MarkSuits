# Mark project configuration: the facts about this project. Keep it in git.
# The workflow itself (roles, review gates, required outputs, who writes which ticket
# artifact) ships with the Mark plugin and updates with it. To change a part of it for this
# project, add the key here: it replaces that one default and the others stay, for example:
#   [gates]
#   tester = ""                          (no gate before the tester)
#   [outputs]
#   coder-impl = []                      (no handoff.md required)
# This profile has no designer: a feature starts at planning, with no design review.
# Role agents, dispatch prompts and artifact formats work the same way: add
# .claude/agents/<role>.md, .mark/prompts/<scenario>.md or .mark/formats/<name>.md.
mark_schema = 1
locale = "{{ locale }}"
profile = "{{ profile }}"

[project]
name = "{{ project_name }}"
main_branch = "{{ main_branch }}"

[paths]
state_dir = ".mark"
service = "{{ service_dir }}"
tests = "{{ tests_dir }}"

# The suite root holds `regression/` (the core-flow journeys `mark merge` runs) and
# `tickets/<id>/` (a ticket's acceptance tests, one per AC).

# End-to-end tests stay black-box: they reach the service only over its public interface
# (HTTP, say), and a tester write under [paths] tests may not import production code or
# read its source.
[tests]
profile = "none"

# `mark merge` runs this shell command in the ticket's worktree after merging the latest
# main into the branch; exit 0 = green. Empty: merge on the tester's verdict alone.
# The scripts ship with Mark and call each module's own selftest.sh / regression.sh, so a
# new regression journey joins the merge check by living in the suite's `regression/`.
[merge]
regression = "bash scripts/selftest.sh && bash scripts/regression.sh"

[worktree]
dir = ".claude/worktrees"
# The main checkout is a state lane: only ticket dirs, gates and locks change there.
# List extra globs here if your team edits them directly on main.
main_writable = []
# A new worktree has only tracked files: no dependencies, no .env, no local config.
# `mark dispatch` and `mark general new` run this shell command in each worktree they create,
# before any agent works there; exit 0 within setup_timeout seconds = ready. It gets the main
# checkout in $MARK_MAIN_CHECKOUT and the branch in $MARK_BRANCH, for example:
#   setup = 'cp "$MARK_MAIN_CHECKOUT/.env" . && ln -s "$MARK_MAIN_CHECKOUT/node_modules" .'
# Everything it creates must be gitignored (a symlink matches `node_modules`, not
# `node_modules/`). On failure the new worktree is removed and the log is kept in
# .mark/locks/<id>.setup.log. Empty: no setup.
setup = "{{ worktree_setup }}"
setup_timeout = 300
# Ports each worktree owns, so tickets can run dev servers and end-to-end tests at the same
# time: env var = first port of its range. After setup, every new worktree gets one free slot
# (0..port_slots-1) and its `.env` gets NAME = base + slot; agents are told their ports. A slot
# is skipped while another worktree's `.env` holds it or something listens on one of its ports.
# Keep the ranges apart from each other and from the ports the main checkout uses, and read
# these names in the dev server and test configs. `.env` must be gitignored. Empty: no ports.
#   ports = { SERVICE_PORT = 8200 }
ports = {}
port_slots = 100

# Doc budgets: byte limits for the docs every role loads (the agent, prompt and format
# globs cover this project's own overrides of the built-ins), so their context does not
# grow by one harmless line at a time. First matching glob wins; max_bytes = 0 exempts
# a path from a broader rule. A write may not leave a doc over budget and larger than it
# was (shrinking an oversized doc is fine), and `mark merge` refuses a branch that does.
# Budget docs whose length follows process complexity, not delivered work: a byte wall on
# an index or a log can only be passed by deleting someone else's record. Delete all
# entries to turn budgets off.
[[doc_budget]]
glob = "**/CLAUDE.md"
max_bytes = 16384

[[doc_budget]]
glob = ".claude/agents/*.md"
max_bytes = 12288

[[doc_budget]]
glob = ".mark/prompts/*.md"
max_bytes = 6144

[[doc_budget]]
glob = ".mark/formats/*.md"
max_bytes = 6144

# A fix plan points coder-impl at the fix; it does not write the code for it.
[[doc_budget]]
glob = ".mark/bugs/*/fix-plan.md"
max_bytes = 12288

# Write scopes. First matching glob wins. A path no rule matches is the main thread's: roles
# may write it only inside their ticket dir. Assign every directory a role works in here.
# "main" is the orchestrator (main thread). The engine checks fixed rules first that no
# project can loosen (.claude/**, .mark/config.toml, gates, locks, status.md and review-*.md
# are main-thread only), then who writes each ticket artifact (requirement.md and bug.md:
# main, design.md: designer, tech-plan.md: coder-plan ...) and the shared docs (CLAUDE.md,
# **/CONTEXT.md, docs/adr/**); a rule here with the same glob replaces one. Then these.
[[write_rules]]
glob = "{{ tests_dir }}/**"
roles = ["tester"]

[[write_rules]]
glob = "{{ service_dir }}/**"
roles = ["coder-impl"]
